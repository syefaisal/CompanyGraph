NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=companygraph123
API_HOST=0.0.0.0
API_PORT=8000
ANTHROPIC_API_KEY=your-key-here
PROMPT_VERSION=v2                          # active prompt file: prompts/v2.yaml
                                           # v1 = base prompts (no safety guidelines)
                                           # v2 = adds output safety guidelines (SSN, card, PII policy)

# Cost budget enforcement — set to 0 to disable
DAILY_COST_LIMIT_USD=5.00                 # all queries route to Haiku once this is exceeded
                                           # reset via POST /admin/reset-budget (no restart needed)

# LangSmith tracing (optional — remove or leave blank to disable)
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_PROJECT=cogni-graph
LANGSMITH_TRACING_V2=true

# ── LangSmith → OTel gateway (LGTM stack) ────────────────────────────────────
# LANGSMITH_OTEL_ENABLED flips the LangSmith SDK from its native client to an
# OTLP exporter. The @traceable decorators and wrap_anthropic() call in
# backend/api.py are unchanged — same spans, different transport.
#
# LANGSMITH_TRACING is the modern spelling of LANGSMITH_TRACING_V2 and is the
# one the OTel path checks. Set BOTH while migrating.
LANGSMITH_TRACING=true
LANGSMITH_OTEL_ENABLED=true

# false = dual-ship to LangSmith Cloud AND the LGTM stack (the ADR's pilot
# parallel-run). Flip to true once Tempo is trusted as system of record.
LANGSMITH_OTEL_ONLY=false

# The agent-tier collector from docker-compose.yml.
# BASE URL ONLY — no /v1/traces suffix. The OTLP exporter appends the signal
# path itself; adding it here produces /v1/traces/v1/traces and the collector
# returns 404 ("Failed to export span batch code: 404"). The LangSmith docs
# show the suffixed form, which is wrong for this variable.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Consumed by the otel-agent collector service, not by the app.
OTEL_SERVICE_NAME=cogni-graph
ENVIRONMENT=dev
LGTM_GATEWAY_ENDPOINT=otelcol-gateway.observability.svc:4317
